# Replace credentials with those for your PostgreSQL instance.
DATABASE_URL=postgresql+asyncpg://cs:replace-me@127.0.0.1:5432/course_select
DATABASE_ISOLATION=READ_COMMITTED
# Configure Redis to enable shared rate limits and a five-second listing cache.
# REDIS_URL=redis://127.0.0.1:6379/0
# Generate a new random value of at least 32 bytes for your JWT secret.
JWT_SECRET=
ENV=dev
# Departments stored in courses.dept, keyed by the public dept_id.
# DEPARTMENT_NAMES={"1":"计算机","2":"软件工程","3":"数学","4":"物理","5":"电子"}
