# 复制本文件为 .env 后按需修改：cp .env.example .env
POSTGRES_USER=cs
POSTGRES_PASSWORD=cs
POSTGRES_DB=course_select
PG_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=8080

DATABASE_URL=postgresql+asyncpg://cs:cs@pg:5432/course_select
DATABASE_ISOLATION=READ_COMMITTED
ENROLLMENT_STRATEGY=atomic
REDIS_URL=redis://redis:6379/0
JWT_SECRET=dev-only-change-me
ENV=dev
