# 复制本文件为 .env 后按需修改：cp .env.example .env
POSTGRES_USER=cs
POSTGRES_PASSWORD=cs
POSTGRES_DB=course_select
PG_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=8080

DATABASE_URL=postgresql+asyncpg://cs:cs@pg:5432/course_select
TEST_DATABASE_URL=postgresql+asyncpg://cs:cs@127.0.0.1:5432/course_select
DATABASE_ISOLATION=READ_COMMITTED
ENROLLMENT_STRATEGY=atomic
REDIS_URL=redis://redis:6379/0
# 本地开发示例密钥（至少 32 字节），部署或对外使用前请替换为随机密钥
JWT_SECRET=dev-only-change-me-at-least-32-bytes-long
ENV=dev
