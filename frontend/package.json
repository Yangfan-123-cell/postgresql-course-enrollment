{
  "name": "course-enrollment-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "vite --mode mock --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json -o src/api/generated.ts"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "msw": "^3.0.7",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
